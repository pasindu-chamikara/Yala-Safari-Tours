rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    function isStaff() {
      return isAuthenticated() && getUserData().role == 'STAFF';
    }

    function isStaffOrAdmin() {
      return isSuperAdmin() || isAdmin() || isStaff();
    }
    
    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------
    match /users/{userId} {
      // Anyone can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Staff and Admins can read all users
      allow read: if isStaffOrAdmin();
      
      // Users can create their own profile upon registration (with role = CUSTOMER)
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId 
                    && request.resource.data.role == 'CUSTOMER';
                    
      // Users can update their own profile (except their role)
      allow update: if isAuthenticated() 
                    && request.auth.uid == userId 
                    && request.resource.data.role == resource.data.role;
                    
      // Super Admins can update/delete anyone.
      // Admins can update/delete STAFF or CUSTOMER, and can only set roles to STAFF or CUSTOMER.
      allow update: if isSuperAdmin() || 
                    (isAdmin() && 
                     resource.data.role in ['STAFF', 'CUSTOMER'] && 
                     request.resource.data.role in ['STAFF', 'CUSTOMER']);
                     
      allow delete: if isSuperAdmin() || 
                    (isAdmin() && resource.data.role in ['STAFF', 'CUSTOMER']);
    }
    
    // ---------------------------------------------------------
    // PACKAGES
    // ---------------------------------------------------------
    match /packages/{packageId} {
      // Anyone can read active packages
      allow read: if true;
      
      // Only staff and admins can write
      allow write: if isStaffOrAdmin();
    }

    // ---------------------------------------------------------
    // BOOKINGS
    // ---------------------------------------------------------
    match /bookings/{bookingId} {
      // Customers can read their own bookings
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Staff and Admins can read all bookings
      allow read: if isStaffOrAdmin();

      // Customers can create bookings, initially PENDING
      allow create: if isAuthenticated() && request.resource.data.status == 'PENDING';
                    
      // Customers cannot update bookings (payment/status managed by staff)
      // Staff and Admins can update bookings
      allow update: if isStaffOrAdmin();
      
      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------
    // VEHICLES
    // ---------------------------------------------------------
    match /vehicles/{vehicleId} {
      // Staff and Admins can read and write
      allow read, write: if isStaffOrAdmin();
    }

    // ---------------------------------------------------------
    // AVAILABILITY
    // ---------------------------------------------------------
    match /availability/{availabilityId} {
      // Anyone can read availability to book
      allow read: if true;
      // Staff and Admins can write
      allow write: if isStaffOrAdmin();
    }

    // ---------------------------------------------------------
    // REVIEWS
    // ---------------------------------------------------------
    match /reviews/{reviewId} {
      // Anyone can read approved reviews
      allow read: if resource.data.approved == true || isStaffOrAdmin();
      
      // Customers can create reviews
      allow create: if isAuthenticated();
      
      // Staff and Admins can update/delete
      allow update, delete: if isStaffOrAdmin();
    }

    // ---------------------------------------------------------
    // NOTIFICATIONS
    // ---------------------------------------------------------
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow write: if isStaffOrAdmin();
    }
    // ---------------------------------------------------------
    // MESSAGES
    // ---------------------------------------------------------
    match /messages/{messageId} {
      // Customers can create a message
      allow create: if isAuthenticated();
      // Only staff and admins can read, update, or delete
      allow read, update, delete: if isStaffOrAdmin();
    }
    // ---------------------------------------------------------
    // SETTINGS
    // ---------------------------------------------------------
    match /settings/{document=**} {
      // Anyone can read settings (for public site configuration)
      allow read: if true;
      // Only Super Admin and Admin can update settings
      allow write: if isSuperAdmin() || isAdmin();
    }
  }
}
